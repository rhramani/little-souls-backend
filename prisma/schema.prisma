// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  CUSTOMER
  STAFF
  SUPER_ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  SHORTAGE
  BACKORDER
}

enum ImageCleaningStatus {
  NOT_REQUIRED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String?  @unique
  mobile       String   @unique
  passwordHash String   @map("password_hash")
  userType     UserType @map("user_type")

  customerId        String? @map("customer_id") @db.Uuid
  customerContactId String? @unique @map("customer_contact_id") @db.Uuid
  staffId           String? @map("staff_id") @db.Uuid

  isActive   Boolean @default(true) @map("is_active")
  isVerified Boolean @default(false) @map("is_verified")

  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  customer        Customer?        @relation(fields: [customerId], references: [id])
  customerContact CustomerContact? @relation(fields: [customerContactId], references: [id])
  staff           StaffProfile?    @relation(fields: [staffId], references: [id])

  userRoles         UserRole[]
  createdCategories Category[] @relation("CategoryCreatedBy")
  updatedCategories Category[] @relation("CategoryUpdatedBy")
  createdProducts   Product[]  @relation("ProductCreatedBy")
  updatedProducts   Product[]  @relation("ProductUpdatedBy")

  // Back-relations added for complete db design
  passwordResetTokens         PasswordResetToken[]
  userSessions                UserSession[]
  createdProductImages        ProductImage[]       @relation("ProductImageCreatedBy")
  createdImageCleaningTasks   ImageCleaningTask[]  @relation("ImageCleaningTaskCreatedBy")
  createdProductCatalogFiles  ProductCatalogFile[] @relation("ProductCatalogFileCreatedBy")
  createdProductVideos        ProductVideo[]       @relation("ProductVideoCreatedBy")
  createdBanners              Banner[]             @relation("BannerCreatedBy")
  createdProductPricing       ProductPricing[]     @relation("ProductPricingCreatedBy")
  updatedProductPricing       ProductPricing[]     @relation("ProductPricingUpdatedBy")
  uploadedCatalogImports      CatalogImport[]      @relation("CatalogImportUploadedBy")
  cancelledOrders             Order[]              @relation("OrderCancelledBy")
  approvedOrders              Order[]              @relation("OrderApprovedBy")
  salesOrders                 Order[]              @relation("OrderSalesStaff")
  orderStatusHistories        OrderStatusHistory[] @relation("OrderStatusHistoryChangedBy")
  requestedBackorderApprovals BackorderApproval[]  @relation("BackorderApprovalRequestedBy")
  approvedBackorderApprovals  BackorderApproval[]  @relation("BackorderApprovalApprovedBy")
  packedPackingSlips          PackingSlip[]        @relation("PackingSlipPackedBy")
  createdShipments            Shipment[]           @relation("ShipmentCreatedBy")
  createdInvoices             Invoice[]            @relation("InvoiceCreatedBy")
  verifiedPayments            Payment[]            @relation("PaymentVerifiedBy")
  receivedPayments            Payment[]            @relation("PaymentReceivedBy")
  createdLedgerEntries        LedgerEntry[]        @relation("LedgerEntryCreatedBy")
  createdCreditDebitNotes     CreditDebitNote[]    @relation("CreditDebitNoteCreatedBy")
  createdPurchaseOrders       PurchaseOrder[]      @relation("PurchaseOrderCreatedBy")
  createdStockMovements       StockMovement[]      @relation("StockMovementCreatedBy")
  approvedAttendanceRecords   AttendanceRecord[]   @relation("AttendanceRecordApprovedBy")
  approvedLeaveRequests       LeaveRequest[]       @relation("LeaveRequestApprovedBy")
  paidPayrolls                Payroll[]            @relation("PayrollPaidBy")
  notifications               Notification[]
  tickets                     SupportTicket[]      @relation("TicketUser")
  assignedTickets             SupportTicket[]      @relation("TicketAssignedTo")
  createdSavedReports         SavedReport[]        @relation("SavedReportCreatedBy")
  auditLogs                   AuditLog[]
  assignedCustomers           Customer[]           @relation("CustomerSalesStaff")
  approvedCustomers           Customer[]           @relation("CustomerApprovedBy")

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model UserSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  refreshToken String    @map("refresh_token")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent") @db.Text
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model StaffProfile {
  id           String    @id @default(uuid()) @db.Uuid
  employeeCode String    @unique @map("employee_code")
  name         String
  mobile       String
  email        String?   @unique
  photoUrl     String?   @map("photo_url")
  designation  String?
  department   String?
  joiningDate  DateTime? @map("joining_date") @db.Date
  salary       Decimal?  @db.Decimal(12, 2)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  users             User[]
  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]
  payrolls          Payroll[]

  @@map("staff_profiles")
}

model Role {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model PricingGroup {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customers      Customer[]
  productPricing ProductPricing[]

  @@map("pricing_groups")
}

model Customer {
  id                   String         @id @default(uuid()) @db.Uuid
  customerCode         String?        @unique @map("customer_code")
  businessName         String         @map("business_name")
  businessType         String?        @map("business_type")
  gstin                String?        @unique
  billingAddressLine1  String?        @map("billing_address_line1")
  billingAddressLine2  String?        @map("billing_address_line2")
  billingCity          String?        @map("billing_city")
  billingState         String?        @map("billing_state")
  billingPincode       String?        @map("billing_pincode")
  billingCountry       String?        @map("billing_country")
  shippingAddressLine1 String?        @map("shipping_address_line1")
  shippingAddressLine2 String?        @map("shipping_address_line2")
  shippingCity         String?        @map("shipping_city")
  shippingState        String?        @map("shipping_state")
  shippingPincode      String?        @map("shipping_pincode")
  shippingCountry      String?        @map("shipping_country")
  storePhotoUrl        String?        @map("store_photo_url")
  customerSource       String?        @map("customer_source")
  mainContactNumber    String         @map("main_contact_number")
  pricingGroupId       String?        @map("pricing_group_id") @db.Uuid
  assignedSalesStaffId String?        @map("assigned_sales_staff_id") @db.Uuid
  approvalStatus       ApprovalStatus @default(PENDING) @map("approval_status")
  approvedBy           String?        @map("approved_by") @db.Uuid
  approvedAt           DateTime?      @map("approved_at")
  rejectionReason      String?        @map("rejection_reason")
  creditLimit          Decimal?       @map("credit_limit") @db.Decimal(12, 2)
  openingBalance       Decimal?       @default(0) @map("opening_balance") @db.Decimal(12, 2)
  currentBalance       Decimal?       @default(0) @map("current_balance") @db.Decimal(12, 2)
  lastOrderAt          DateTime?      @map("last_order_at")
  isActive             Boolean        @default(false) @map("is_active")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  pricingGroup PricingGroup?     @relation(fields: [pricingGroupId], references: [id])
  contacts     CustomerContact[]
  users        User[]

  // Back-relations
  assignedSalesStaff User?             @relation("CustomerSalesStaff", fields: [assignedSalesStaffId], references: [id])
  approvedByUser     User?             @relation("CustomerApprovedBy", fields: [approvedBy], references: [id])
  carts              Cart[]
  orders             Order[]
  invoices           Invoice[]
  payments           Payment[]
  ledgerEntries      LedgerEntry[]
  creditDebitNotes   CreditDebitNote[]
  supportTickets     SupportTicket[]

  @@map("customers")
}

model CustomerContact {
  id                 String   @id @default(uuid()) @db.Uuid
  customerId         String   @map("customer_id") @db.Uuid
  name               String
  photoUrl           String?  @map("photo_url")
  mobile             String
  whatsappNumber     String?  @map("whatsapp_number")
  email              String?
  designation        String?
  loginAccess        Boolean  @default(false) @map("login_access")
  isPrimary          Boolean  @default(false) @map("is_primary")
  isActive           Boolean  @default(true) @map("is_active")
  canPlaceOrder      Boolean  @default(true) @map("can_place_order")
  canViewLedger      Boolean  @default(false) @map("can_view_ledger")
  canDownloadInvoice Boolean  @default(false) @map("can_download_invoice")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?

  // Back-relations
  carts  Cart[]
  orders Order[]

  @@map("customer_contacts")
}

model Category {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  slug             String   @unique
  parentCategoryId String?  @map("parent_category_id") @db.Uuid
  imageUrl         String?  @map("image_url")
  bannerUrl        String?  @map("banner_url")
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int?     @map("sort_order")
  createdBy        String?  @map("created_by") @db.Uuid
  updatedBy        String?  @map("updated_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  parentCategory  Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  childCategories Category[] @relation("CategoryHierarchy")
  createdByUser   User?      @relation("CategoryCreatedBy", fields: [createdBy], references: [id])
  updatedByUser   User?      @relation("CategoryUpdatedBy", fields: [updatedBy], references: [id])
  products        Product[]

  @@map("categories")
}

model Product {
  id                  String      @id @default(uuid()) @db.Uuid
  sku                 String      @unique
  name                String
  slug                String      @unique
  shortDescription    String?     @map("short_description")
  description         String?
  categoryId          String      @map("category_id") @db.Uuid
  moq                 Int         @default(1)
  barcode             String?
  barcodeUrl          String?
  brand               String?
  size                String?
  color               String?
  material            String?
  unit                String?     @default("PCS")
  hsnCode             String?     @map("hsn_code")
  weight              Decimal?    @db.Decimal(10, 2)
  taxPercent          Decimal?    @map("tax_percent") @db.Decimal(5, 2)
  stockQuantity       Int         @default(0) @map("stock_quantity")
  stockStatus         StockStatus @default(IN_STOCK) @map("stock_status")
  allowBackorder      Boolean     @default(false) @map("allow_backorder")
  expectedRestockDate DateTime?   @map("expected_restock_date") @db.Date
  tags                String?
  isActive            Boolean     @default(true) @map("is_active")
  isFeatured          Boolean     @default(false) @map("is_featured")
  sortOrder           Int?        @map("sort_order")
  publishedAt         DateTime?   @map("published_at")
  createdBy           String?     @map("created_by") @db.Uuid
  updatedBy           String?     @map("updated_by") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  productImage                 String?   @map("product_image")
  productPrice                 Decimal?  @map("product_price") @db.Decimal(12, 2)
  discountedPrice              Decimal?  @map("discounted_price") @db.Decimal(12, 2)
  parentProductSku             String?   @map("parent_product_sku")
  taxType                      String?   @map("tax_type")
  productPictureUrl            String?   @map("product_picture_url")
  privateNotes                 String?   @map("private_notes")
  parentProductId              String?   @map("parent_product_id")
  setName                      String?   @map("set_name")
  setQuantity                  Int?      @map("set_quantity")
  setType                      String?   @map("set_type")
  sizes                        String?
  sizesSetQuantity             Int?      @map("sizes_set_quantity")
  colors                       String?
  colorsSetQuantity            Int?      @map("colors_set_quantity")
  nt11_48                      String?   @map("nt11_48")
  nt11_48SetQuantity           Int?      @map("nt11_48_set_quantity")
  sixToTwelveMonths            String?   @map("six_to_twelve_months")
  sixToTwelveMonthsSetQuantity Int?      @map("six_to_twelve_months_set_quantity")

  category      Category @relation(fields: [categoryId], references: [id])
  createdByUser User?    @relation("ProductCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?    @relation("ProductUpdatedBy", fields: [updatedBy], references: [id])

  catalogueId   String?    @map("catalogue_id") @db.Uuid
  catalogue     Catalogue? @relation(fields: [catalogueId], references: [id], onDelete: Cascade)

  images  ProductImage[]
  pricing ProductPricing[]

  // Back-relations
  imageCleaningTasks ImageCleaningTask[]
  catalogFiles       ProductCatalogFile[]
  videos             ProductVideo[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  backorderApprovals BackorderApproval[]
  invoiceItems       InvoiceItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockMovements     StockMovement[]

  @@map("products")
}

model ProductImage {
  id             String              @id @default(uuid()) @db.Uuid
  productId      String              @map("product_id") @db.Uuid
  originalUrl    String              @map("original_url")
  cleanedUrl     String?             @map("cleaned_url")
  thumbnailUrl   String?             @map("thumbnail_url")
  altText        String?             @map("alt_text")
  sortOrder      Int?                @map("sort_order")
  isPrimary      Boolean             @default(false) @map("is_primary")
  cleaningStatus ImageCleaningStatus @default(NOT_REQUIRED) @map("cleaning_status")
  createdBy      String?             @map("created_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdByUser      User?               @relation("ProductImageCreatedBy", fields: [createdBy], references: [id])
  imageCleaningTasks ImageCleaningTask[]

  @@map("product_images")
}

model ImageCleaningTask {
  id             String   @id @default(uuid()) @db.Uuid
  productImageId String   @map("product_image_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  provider       String
  originalUrl    String   @map("original_url")
  cleanedUrl     String?  @map("cleaned_url")
  status         String // "PENDING", "PROCESSING", "COMPLETED", "FAILED"
  apiResponse    String?  @map("api_response") @db.Text
  errorMessage   String?  @map("error_message") @db.Text
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  productImage  ProductImage @relation(fields: [productImageId], references: [id], onDelete: Cascade)
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdByUser User?        @relation("ImageCleaningTaskCreatedBy", fields: [createdBy], references: [id])

  @@map("image_cleaning_tasks")
}

model ProductCatalogFile {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  fileType  String   @map("file_type") // "JPG", "PDF"
  fileUrl   String   @map("file_url")
  title     String
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdByUser User?   @relation("ProductCatalogFileCreatedBy", fields: [createdBy], references: [id])

  @@map("product_catalog_files")
}

model ProductVideo {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  videoUrl     String   @map("video_url")
  thumbnailUrl String?  @map("thumbnail_url")
  title        String
  videoType    String   @map("video_type") // "PRODUCT_VIDEO", "SHORT_DEMO_VIDEO"
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdByUser User?   @relation("ProductVideoCreatedBy", fields: [createdBy], references: [id])

  @@map("product_videos")
}

model Banner {
  id              String   @id @default(uuid()) @db.Uuid
  title           String
  label           String?
  bannerType      String   @map("banner_type") // "HERO", "CATEGORY", "PROMO", "WEB_HEADER", "MOBILE"
  imageUrl        String   @map("image_url")
  linkType        String   @map("link_type") // "CATEGORY", "PRODUCT", "CUSTOM", "NONE"
  linkReferenceId String?  @map("link_reference_id") @db.Uuid
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int?     @map("sort_order")
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  createdByUser User? @relation("BannerCreatedBy", fields: [createdBy], references: [id])

  @@map("banners")
}

model ProductPricing {
  id              String    @id @default(uuid()) @db.Uuid
  productId       String    @map("product_id") @db.Uuid
  pricingGroupId  String    @map("pricing_group_id") @db.Uuid
  price           Decimal   @db.Decimal(12, 2)
  mrp             Decimal?  @db.Decimal(12, 2)
  discountPercent Decimal?  @map("discount_percent") @db.Decimal(5, 2)
  minQuantity     Int?      @map("min_quantity")
  maxQuantity     Int?      @map("max_quantity")
  effectiveFrom   DateTime? @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date
  createdBy       String?   @map("created_by") @db.Uuid
  updatedBy       String?   @map("updated_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  pricingGroup  PricingGroup @relation(fields: [pricingGroupId], references: [id], onDelete: Cascade)
  createdByUser User?        @relation("ProductPricingCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?        @relation("ProductPricingUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([productId, pricingGroupId])
  @@map("product_pricing")
}

model CatalogImport {
  id           String   @id @default(uuid()) @db.Uuid
  fileUrl      String   @map("file_url")
  importType   String   @map("import_type") // "PRODUCT_CREATE", "PRODUCT_UPDATE", "PRICE_UPDATE", "STOCK_UPDATE"
  status       String // "PENDING", "PROCESSING", "COMPLETED", "FAILED"
  totalRows    Int?     @map("total_rows")
  successRows  Int?     @map("success_rows")
  failedRows   Int?     @map("failed_rows")
  errorFileUrl String?  @map("error_file_url")
  uploadedBy   String   @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  uploadedByUser User               @relation("CatalogImportUploadedBy", fields: [uploadedBy], references: [id])
  rows           CatalogImportRow[]

  @@map("catalog_imports")
}

model CatalogImportRow {
  id              String   @id @default(uuid()) @db.Uuid
  catalogImportId String   @map("catalog_import_id") @db.Uuid
  rowNumber       Int      @map("row_number")
  sku             String?
  status          String // "SUCCESS", "FAILED", "SKIPPED"
  errorMessage    String?  @map("error_message") @db.Text
  rawData         String?  @map("raw_data") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  catalogImport CatalogImport @relation(fields: [catalogImportId], references: [id], onDelete: Cascade)

  @@map("catalog_import_rows")
}

model Cart {
  id                String   @id @default(uuid()) @db.Uuid
  customerId        String   @map("customer_id") @db.Uuid
  customerContactId String?  @map("customer_contact_id") @db.Uuid
  status            String   @default("ACTIVE") // "ACTIVE", "CONVERTED", "ABANDONED"
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerContact CustomerContact? @relation(fields: [customerContactId], references: [id])
  items           CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  price     Decimal  @db.Decimal(12, 2)
  lineTotal Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id                    String    @id @default(uuid()) @db.Uuid
  orderNumber           String    @unique @map("order_number")
  customerId            String    @map("customer_id") @db.Uuid
  customerContactId     String?   @map("customer_contact_id") @db.Uuid
  orderStatus           String    @map("order_status") // "DRAFT", "SUBMITTED", "APPROVED", "PACKED", "SHIPPED", "DELIVERED", "CANCELLED"
  orderSource           String    @map("order_source") // "WEBSITE", "MOBILE_APP", "STAFF_PANEL", "WHATSAPP"
