  category           String?
  brand              String?
  supplierId         String    @map("supplier_id") @db.ObjectId
  purchaseInvoiceId  String?   @map("purchase_invoice_id") @db.ObjectId
  purchaseDate       DateTime  @map("purchase_date")
  description        String?
  status             String    @default("Active")
  movedToCatalogId   String?   @map("moved_to_catalog_id")
  movedToCategoryId  String?   @map("moved_to_category_id")
  movedQuantity      Int?      @default(0) @map("moved_quantity")
  movedAt            DateTime? @map("moved_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  supplier        Supplier         @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("purchased_products")
}

model PurchaseInvoice {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber  String   @unique @map("invoice_number")
  invoiceDate    DateTime @map("invoice_date")
  supplierId     String   @map("supplier_id") @db.ObjectId
  businessState  String   @map("business_state")
  withGst        Boolean  @map("with_gst")
  gstRate        Float    @map("gst_rate")
  subtotal        Float
  discountAmount  Float    @map("discount_amount")
  discountPercent Float?   @default(0) @map("discount_percent")
  discountOther   Float?   @default(0) @map("discount_other")
  otherCharges    Float?   @default(0) @map("other_charges")
  cgstAmount      Float    @map("cgst_amount")
  sgstAmount     Float    @map("sgst_amount")
  igstAmount     Float    @map("igst_amount")
  grandTotal     Float    @map("grand_total")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  supplier          Supplier              @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items             PurchaseInvoiceItem[]
  purchasedProducts PurchasedProduct[]
  supplierPayments  SupplierPayment[]

  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  purchaseInvoiceId String   @map("purchase_invoice_id") @db.ObjectId
  productId         String?  @map("product_id") @db.ObjectId
  name              String
  sku               String
  purchasePrice     Float    @map("purchase_price")
  sellingPrice      Float?   @map("selling_price")
  quantity          Int
  unit              String
  discountPercent   Float    @map("discount_percent")
  discountOther     Float    @default(0) @map("discount_other")
  otherCharges      Float    @default(0) @map("other_charges")
  taxPercent        Float    @map("tax_percent")
  total             Float

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("purchase_invoice_items")
}

model CustomerActivitySession {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  sessionId        String?   @map("session_id")
  customerId       String    @map("customer_id") @db.ObjectId
  userId           String    @map("user_id") @db.ObjectId
  loginTime        DateTime  @map("login_time")
  logoutTime       DateTime? @map("logout_time")
  totalDuration    Int?      @map("total_duration_seconds")
  status           String    @default("ACTIVE")
  sectionDurations String?   @map("section_durations")
  activities       String?   @map("activities")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("customer_activity_sessions")
}


