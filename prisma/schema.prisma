// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider     = "mongodb"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum UserType {
  CUSTOMER
  STAFF
  SUPER_ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  SHORTAGE
  BACKORDER
}

enum ImageCleaningStatus {
  NOT_REQUIRED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String?  @unique
  mobile       String   @unique
  passwordHash String   @map("password_hash")
  plainPassword String? @map("plain_password")
  userType     UserType @map("user_type")

  customerId        String? @map("customer_id") @db.ObjectId
  customerContactId String? @unique @map("customer_contact_id") @db.ObjectId
  staffId           String? @map("staff_id") @db.ObjectId

  isActive   Boolean @default(true) @map("is_active")
  isVerified Boolean @default(false) @map("is_verified")

  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customerContact CustomerContact? @relation(fields: [customerContactId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff           StaffProfile?    @relation(fields: [staffId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  userRoles         UserRole[]
  createdCategories Category[] @relation("CategoryCreatedBy")
  updatedCategories Category[] @relation("CategoryUpdatedBy")
  createdProducts   Product[]  @relation("ProductCreatedBy")
  updatedProducts   Product[]  @relation("ProductUpdatedBy")

  // Back-relations added for complete db design
  passwordResetTokens         PasswordResetToken[]
  userSessions                UserSession[]
  createdProductImages        ProductImage[]       @relation("ProductImageCreatedBy")
  createdImageCleaningTasks   ImageCleaningTask[]  @relation("ImageCleaningTaskCreatedBy")
  createdProductCatalogFiles  ProductCatalogFile[] @relation("ProductCatalogFileCreatedBy")
  createdProductVideos        ProductVideo[]       @relation("ProductVideoCreatedBy")
  createdBanners              Banner[]             @relation("BannerCreatedBy")
  createdProductPricing       ProductPricing[]     @relation("ProductPricingCreatedBy")
  updatedProductPricing       ProductPricing[]     @relation("ProductPricingUpdatedBy")
  uploadedCatalogImports      CatalogImport[]      @relation("CatalogImportUploadedBy")
  cancelledOrders             Order[]              @relation("OrderCancelledBy")
  approvedOrders              Order[]              @relation("OrderApprovedBy")
  salesOrders                 Order[]              @relation("OrderSalesStaff")
  orderStatusHistories        OrderStatusHistory[] @relation("OrderStatusHistoryChangedBy")
  requestedBackorderApprovals BackorderApproval[]  @relation("BackorderApprovalRequestedBy")
  approvedBackorderApprovals  BackorderApproval[]  @relation("BackorderApprovalApprovedBy")
  packedPackingSlips          PackingSlip[]        @relation("PackingSlipPackedBy")
  createdShipments            Shipment[]           @relation("ShipmentCreatedBy")
  createdInvoices             Invoice[]            @relation("InvoiceCreatedBy")
  verifiedPayments            Payment[]            @relation("PaymentVerifiedBy")
  receivedPayments            Payment[]            @relation("PaymentReceivedBy")
  createdLedgerEntries        LedgerEntry[]        @relation("LedgerEntryCreatedBy")
  createdStockMovements       StockMovement[]      @relation("StockMovementCreatedBy")
  approvedAttendanceRecords   AttendanceRecord[]   @relation("AttendanceRecordApprovedBy")
  approvedLeaveRequests       LeaveRequest[]       @relation("LeaveRequestApprovedBy")
  paidPayrolls                Payroll[]            @relation("PayrollPaidBy")
  notifications               Notification[]
  tickets                     SupportTicket[]      @relation("TicketUser")
  assignedTickets             SupportTicket[]      @relation("TicketAssignedTo")
  createdSavedReports         SavedReport[]        @relation("SavedReportCreatedBy")
  assignedCustomers           Customer[]           @relation("CustomerSalesStaff")
  approvedCustomers           Customer[]           @relation("CustomerApprovedBy")
  customerActivitySessions    CustomerActivitySession[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @map("user_id") @db.ObjectId
  token     String
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("password_reset_tokens")
}

model UserSession {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @map("user_id") @db.ObjectId
  refreshToken String    @map("refresh_token")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("user_sessions")
}

model StaffProfile {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  employeeCode String    @unique @map("employee_code")
  name         String
  mobile       String
  email        String?   @unique
  photoUrl     String?   @map("photo_url")
  designation  String?
  department   String?
  joiningDate  DateTime? @map("joining_date")
  salary       Float?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  users             User[]
  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]
  payrolls          Payroll[]

  @@map("staff_profiles")
}

model Role {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String   @unique
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  roleId       String   @map("role_id") @db.ObjectId
  permissionId String   @map("permission_id") @db.ObjectId
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id") @db.ObjectId
  roleId    String   @map("role_id") @db.ObjectId
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role Role @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model PricingGroup {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customers      Customer[]
  productPricing ProductPricing[]

  @@map("pricing_groups")
}

model Customer {
  id                   String         @id @default(auto()) @map("_id") @db.ObjectId
  customerCode         String?        @unique @map("customer_code")
  businessName         String         @map("business_name")
  businessType         String?        @map("business_type")
  gstin                String?
  billingAddressLine1  String?        @map("billing_address_line1")
  billingAddressLine2  String?        @map("billing_address_line2")
  billingCity          String?        @map("billing_city")
  billingState         String?        @map("billing_state")
  billingPincode       String?        @map("billing_pincode")
  billingCountry       String?        @map("billing_country")
  shippingAddressLine1 String?        @map("shipping_address_line1")
  shippingAddressLine2 String?        @map("shipping_address_line2")
  shippingCity         String?        @map("shipping_city")
  shippingState        String?        @map("shipping_state")
  shippingPincode      String?        @map("shipping_pincode")
  shippingCountry      String?        @map("shipping_country")
  storePhotoUrl        String?        @map("store_photo_url")
  customerSource       String?        @map("customer_source")
  mainContactNumber    String         @map("main_contact_number")
  pricingGroupId       String?        @map("pricing_group_id") @db.ObjectId
  assignedSalesStaffId String?        @map("assigned_sales_staff_id") @db.ObjectId
  approvalStatus       ApprovalStatus @default(PENDING) @map("approval_status")
  approvedBy           String?        @map("approved_by") @db.ObjectId
  approvedAt           DateTime?      @map("approved_at")
  rejectionReason      String?        @map("rejection_reason")
  creditLimit          Float?       @map("credit_limit")
  openingBalance       Float?       @default(0) @map("opening_balance")
  currentBalance       Float?       @default(0) @map("current_balance")
  lastOrderAt          DateTime?      @map("last_order_at")
  isActive             Boolean        @default(false) @map("is_active")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  pricingGroup PricingGroup?     @relation(fields: [pricingGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contacts     CustomerContact[]
  users        User[]

  // Back-relations
  assignedSalesStaff User?             @relation("CustomerSalesStaff", fields: [assignedSalesStaffId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedByUser     User?             @relation("CustomerApprovedBy", fields: [approvedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  carts              Cart[]
  orders             Order[]
  invoices           Invoice[]
  payments           Payment[]
  ledgerEntries      LedgerEntry[]
  supportTickets     SupportTicket[]
  customerActivitySessions CustomerActivitySession[]

  @@map("customers")
}

model CustomerContact {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId         String   @map("customer_id") @db.ObjectId
  name               String
  photoUrl           String?  @map("photo_url")
  mobile             String
  whatsappNumber     String?  @map("whatsapp_number")
  email              String?
  designation        String?
  loginAccess        Boolean  @default(false) @map("login_access")
  isPrimary          Boolean  @default(false) @map("is_primary")
  isActive           Boolean  @default(true) @map("is_active")
  canPlaceOrder      Boolean  @default(true) @map("can_place_order")
  canViewLedger      Boolean  @default(false) @map("can_view_ledger")
  canDownloadInvoice Boolean  @default(false) @map("can_download_invoice")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user     User?

  // Back-relations
  carts  Cart[]
  orders Order[]

  @@map("customer_contacts")
}

model Category {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  slug             String   @unique
  description      String?
  parentCategoryId String?  @map("parent_category_id") @db.ObjectId
  imageUrl         String?  @map("image_url")
  bannerUrl        String?  @map("banner_url")
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int?     @map("sort_order")
  createdBy        String?  @map("created_by") @db.ObjectId
  updatedBy        String?  @map("updated_by") @db.ObjectId
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  parentCategory  Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childCategories Category[] @relation("CategoryHierarchy")
  createdByUser   User?      @relation("CategoryCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedByUser   User?      @relation("CategoryUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  catalogueId      String?   @map("catalogue_id") @db.ObjectId
  catalogue        Catalogue? @relation(fields: [catalogueId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  products        Product[]

  @@map("categories")
}

model Product {
  id                  String      @id @default(auto()) @map("_id") @db.ObjectId
  sku                 String      @unique
  name                String
  slug                String      @unique
  shortDescription    String?     @map("short_description")
  description         String?
  categoryId          String      @map("category_id") @db.ObjectId
  moq                 Int         @default(1)
  wholesalerMoq       Int?        @map("wholesaler_moq")
  fixQty              Int?        @map("fix_qty")
  barcode             String?
  barcodeUrl          String?
  material            String?
  unit                String?     @default("PCS")
  hsnCode             String?     @map("hsn_code")
  weight              Float?
  taxPercent          Float?    @map("tax_percent")
  stockQuantity       Int         @default(0) @map("stock_quantity")
  stockStatus         StockStatus @default(IN_STOCK) @map("stock_status")
  allowBackorder      Boolean     @default(false) @map("allow_backorder")
  expectedRestockDate DateTime?   @map("expected_restock_date")
  tags                String?
  isActive            Boolean     @default(true) @map("is_active")
  isFeatured          Boolean     @default(false) @map("is_featured")
  sortOrder           Int?        @map("sort_order")
  publishedAt         DateTime?   @map("published_at")
  createdBy           String?     @map("created_by") @db.ObjectId
  updatedBy           String?     @map("updated_by") @db.ObjectId
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  productImage                 String?   @map("product_image")
  productPrice                 Float?  @map("product_price")
  discountedPrice              Float?  @map("discounted_price")
  parentProductSku             String?   @map("parent_product_sku")
  taxType                      String?   @map("tax_type")
  productPictureUrl            String?   @map("product_picture_url")
  privateNotes                 String?   @map("private_notes")
  parentProductId              String?   @map("parent_product_id")

  hasSize                      Boolean   @default(false) @map("has_size")
  hasColor                     Boolean   @default(false) @map("has_color")
  sizes                        Json?     // [{size:"S",fixQty:6},{size:"ALL",fixQty:10}]
  colors                       Json?     // [{color:"Red",fixQty:3,images:["url1","url2"]},..]

  category      Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdByUser User?    @relation("ProductCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedByUser User?    @relation("ProductUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  catalogueIds  String[]    @map("catalogue_ids") @db.ObjectId
  catalogues    Catalogue[] @relation(fields: [catalogueIds], references: [id])

  images  ProductImage[]
  pricing ProductPricing[]

  // Back-relations
  imageCleaningTasks ImageCleaningTask[]
  catalogFiles       ProductCatalogFile[]
  videos             ProductVideo[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  backorderApprovals BackorderApproval[]
  invoiceItems       InvoiceItem[]
  stockMovements     StockMovement[]

  @@map("products")
}

model ProductImage {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  productId      String              @map("product_id") @db.ObjectId
  originalUrl    String              @map("original_url")
  cleanedUrl     String?             @map("cleaned_url")
  thumbnailUrl   String?             @map("thumbnail_url")
  altText        String?             @map("alt_text")
  sortOrder      Int?                @map("sort_order")
  isPrimary      Boolean             @default(false) @map("is_primary")
  color          String?             // Color this image belongs to (null = general)
  cleaningStatus ImageCleaningStatus @default(NOT_REQUIRED) @map("cleaning_status")
  createdBy      String?             @map("created_by") @db.ObjectId
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  product            Product             @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdByUser      User?               @relation("ProductImageCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  imageCleaningTasks ImageCleaningTask[]

  @@map("product_images")
}

model ImageCleaningTask {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  productImageId String   @map("product_image_id") @db.ObjectId
  productId      String   @map("product_id") @db.ObjectId
  provider       String
  originalUrl    String   @map("original_url")
  cleanedUrl     String?  @map("cleaned_url")
  status         String // "PENDING", "PROCESSING", "COMPLETED", "FAILED"
  apiResponse    String?  @map("api_response")
  errorMessage   String?  @map("error_message")
  createdBy      String?  @map("created_by") @db.ObjectId
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  productImage  ProductImage @relation(fields: [productImageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product       Product      @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdByUser User?        @relation("ImageCleaningTaskCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("image_cleaning_tasks")
}

model ProductCatalogFile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  productId String   @map("product_id") @db.ObjectId
  fileType  String   @map("file_type") // "JPG", "PDF"
  fileUrl   String   @map("file_url")
  title     String
  createdBy String?  @map("created_by") @db.ObjectId
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product       Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdByUser User?   @relation("ProductCatalogFileCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("product_catalog_files")
}

model ProductVideo {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  productId    String   @map("product_id") @db.ObjectId
  videoUrl     String   @map("video_url")
  thumbnailUrl String?  @map("thumbnail_url")
  title        String
  videoType    String   @map("video_type") // "PRODUCT_VIDEO", "SHORT_DEMO_VIDEO"
  createdBy    String?  @map("created_by") @db.ObjectId
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product       Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdByUser User?   @relation("ProductVideoCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("product_videos")
}

model Banner {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  label           String?
  bannerType      String   @map("banner_type") // "HERO", "CATEGORY", "PROMO", "WEB_HEADER", "MOBILE"
  imageUrl        String   @map("image_url")
  linkType        String   @map("link_type") // "CATEGORY", "PRODUCT", "CUSTOM", "NONE"
  linkReferenceId String?  @map("link_reference_id") @db.ObjectId
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int?     @map("sort_order")
  createdBy       String?  @map("created_by") @db.ObjectId
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  createdByUser User? @relation("BannerCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("banners")
}

model ProductPricing {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  productId       String    @map("product_id") @db.ObjectId
  pricingGroupId  String    @map("pricing_group_id") @db.ObjectId
  price           Float
  mrp             Float?
  discountPercent Float?  @map("discount_percent")
  minQuantity     Int?      @map("min_quantity")
  maxQuantity     Int?      @map("max_quantity")
  effectiveFrom   DateTime? @map("effective_from")
  effectiveTo     DateTime? @map("effective_to")
  createdBy       String?   @map("created_by") @db.ObjectId
  updatedBy       String?   @map("updated_by") @db.ObjectId
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  product       Product      @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pricingGroup  PricingGroup @relation(fields: [pricingGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdByUser User?        @relation("ProductPricingCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedByUser User?        @relation("ProductPricingUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([productId, pricingGroupId])
  @@map("product_pricing")
}

model CatalogImport {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  fileUrl      String   @map("file_url")
  importType   String   @map("import_type") // "PRODUCT_CREATE", "PRODUCT_UPDATE", "PRICE_UPDATE", "STOCK_UPDATE"
  status       String // "PENDING", "PROCESSING", "COMPLETED", "FAILED"
  totalRows    Int?     @map("total_rows")
  successRows  Int?     @map("success_rows")
  failedRows   Int?     @map("failed_rows")
  errorFileUrl String?  @map("error_file_url")
  uploadedBy   String   @map("uploaded_by") @db.ObjectId
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  uploadedByUser User               @relation("CatalogImportUploadedBy", fields: [uploadedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rows           CatalogImportRow[]

  @@map("catalog_imports")
}

model CatalogImportRow {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  catalogImportId String   @map("catalog_import_id") @db.ObjectId
  rowNumber       Int      @map("row_number")
  sku             String?
  status          String // "SUCCESS", "FAILED", "SKIPPED"
  errorMessage    String?  @map("error_message")
  rawData         String?  @map("raw_data")
  createdAt       DateTime @default(now()) @map("created_at")

  catalogImport CatalogImport @relation(fields: [catalogImportId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("catalog_import_rows")
}

model Cart {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId        String   @map("customer_id") @db.ObjectId
  customerContactId String?  @map("customer_contact_id") @db.ObjectId
  status            String   @default("ACTIVE") // "ACTIVE", "CONVERTED", "ABANDONED"
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customerContact CustomerContact? @relation(fields: [customerContactId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items           CartItem[]

  @@map("carts")
}

model CartItem {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  cartId        String   @map("cart_id") @db.ObjectId
  productId     String   @map("product_id") @db.ObjectId
  quantity      Int
  price         Float
  lineTotal     Float    @map("line_total")
